from flask import Flask
from threading import Thread
import os

app = Flask(__name__)

@app.route("/")
def home():
    return "🤖 RJ Team Bangladesh Auto Post Bot is Running!"

@app.route("/health")
def health():
    return {"status": "ok", "bot": "running"}

def run():
    app.run(
        host="0.0.0.0",
        port=int(os.getenv("PORT", 10000)),
        debug=False,
        use_reloader=False,
    )

def keep_alive():
    t = Thread(target=run)
    t.daemon = True
    t.start()
